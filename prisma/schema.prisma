generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model CartSettings {
  id    String @id @default(cuid())
  shop  String @unique

  // General
  enabled      Boolean @default(true)
  headerText   String  @default("Your Cart")
  primaryColor String  @default("#000000")

  // Banner
  bannerEnabled   Boolean @default(true)
  bannerText      String  @default("🎉 Free shipping on orders over $50!")
  bannerBgColor   String  @default("#1a1a1a")
  bannerTextColor String  @default("#ffffff")

  // Discount
  discountEnabled     Boolean @default(true)
  autoDiscountEnabled Boolean @default(false)
  autoDiscountCode    String  @default("")
  autoDiscountMode    String  @default("exact")
  configuredDiscounts String  @default("[]")
  offersEnabled       Boolean @default(false)

  // Order notes & display
  orderNotesEnabled      Boolean @default(false)
  showVariantTitle       Boolean @default(true)
  scrollableItems        Boolean @default(true)
  showLineItemProperties Boolean @default(false)

  // Upsell
  upsellEnabled           Boolean @default(false)
  upsellSliderEnabled     Boolean @default(true)
  upsellTitle             String  @default("You might also like")
  upsellTriggerType       String  @default("cartValue")
  upsellMinCartValue      Float   @default(50)
  upsellMinQuantity       Int     @default(2)
  upsellProducts          String  @default("[]")
  upsellTriggerProductIds    String  @default("[]")
  upsellTriggerCollectionIds String  @default("[]")

  // Freebie
  freebieEnabled           Boolean @default(false)
  freebieTitle             String  @default("🎁 You've earned a free gift!")
  freebieTriggerType       String  @default("cartValue")
  freebieMinCartValue      Float   @default(100)
  freebieMinQuantity       Int     @default(3)
  freebieProductVariantId  String?
  freebieProductTitle      String?
  freebieProductImageUrl   String?
  freebieTriggerProductIds    String  @default("[]")
  freebieTriggerCollectionIds String  @default("[]")
  freebieMaxCartValue         Float?
  freebieMaxQuantity          Int?
  freebieConditionLogic       String  @default("AND")
  freebieConfettiEnabled      Boolean @default(true)

  // Scarcity countdown timer
  scarcityEnabled   Boolean @default(false)
  scarcityText      String  @default("⏰ Offer ends in:")
  scarcityMinutes   Int     @default(15)
  scarcityBgColor   String  @default("#e53e3e")
  scarcityTextColor String  @default("#ffffff")

  // Tiered rewards
  tieredRewardsEnabled Boolean @default(false)
  tieredRewards        String  @default("[]")

  // AI-powered upsell (Shopify Recommendations API)
  aiUpsellEnabled Boolean @default(false)
  aiUpsellTitle   String  @default("Customers Also Bought")
  aiUpsellIntent  String  @default("related")
  aiUpsellLimit   Int     @default(4)

  // Multiple freebie offers (up to 5)
  freebieOffers              String  @default("[]")
  freebieShowAtTop           Boolean @default(false)
  freebieProgressBarEnabled  Boolean @default(true)

  // Block /cart page — redirect to side cart instead
  blockCartPage Boolean @default(false)

  // Custom code injection
  customCss String @default("")
  customJs  String @default("")

  // Custom cart icon selector (for themes not in the built-in map)
  customCartIconSelector String @default("")

  // Line item title links
  clickableLineItems Boolean @default(true)

  // Add-to-cart behavior: "drawer" (open side cart) | "toast" (show popup)
  addToCartBehavior    String @default("drawer")
  addToCartToastSeconds Int   @default(3)

  // Order summary dropdown above checkout button
  orderSummaryEnabled Boolean @default(true)

  // One-click upsell (checkbox below cart items)
  ocuEnabled           Boolean @default(false)
  ocuHeading           String  @default("Complete your order")
  ocuLabel             String  @default("Add to your order")
  ocuHideWhenInCart    Boolean @default(true)
  ocuProductVariantId  String  @default("")
  ocuProductTitle      String  @default("")
  ocuProductImageUrl   String  @default("")
  ocuProductPrice      Int     @default(0)

  // Billing plan: "starter" | "growth" | "enterprise"
  planName    String  @default("starter")
  freeForever Boolean @default(false)

  // Free Shipping Progress Bar
  freeShippingBarEnabled   Boolean @default(false)
  freeShippingThreshold    Float   @default(50)
  freeShippingText         String  @default("Add {{amount}} more for FREE shipping!")
  freeShippingUnlockedText String  @default("You've unlocked free shipping!")

  // Trust Badges
  trustBadgesEnabled Boolean @default(false)
  trustBadges        String  @default("[]")

  // Sticky Add-to-Cart
  stickyAtcEnabled Boolean @default(false)
  stickyAtcText    String  @default("Add to Cart")

  // Express Checkout Buttons
  expressCheckoutEnabled   Boolean @default(false)
  expressCheckoutShopPay   Boolean @default(true)
  expressCheckoutApplePay  Boolean @default(true)
  expressCheckoutGooglePay Boolean @default(false)

  // Volume Discounts
  volumeDiscountEnabled Boolean @default(false)
  volumeDiscountTitle   String  @default("Buy more, save more!")
  volumeDiscounts       String  @default("[]")

  // Gift Wrap
  giftWrapEnabled          Boolean @default(false)
  giftWrapHeading          String  @default("Gift Options")
  giftWrapLabel            String  @default("Add gift wrap")
  giftWrapHideWhenInCart   Boolean @default(true)
  giftWrapProductVariantId String  @default("")
  giftWrapProductTitle     String  @default("")
  giftWrapProductImageUrl  String  @default("")
  giftWrapPrice            Int     @default(0)

  // Stock Scarcity on Line Items
  stockScarcityEnabled   Boolean @default(false)
  stockScarcityThreshold Int     @default(5)
  stockScarcityText      String  @default("Only {{count}} left!")

  // Recently Viewed (empty cart)
  recentlyViewedEnabled Boolean @default(false)
  recentlyViewedTitle   String  @default("You might also like")
  recentlyViewedLimit   Int     @default(4)

  // Cart Share Link
  cartShareEnabled Boolean @default(false)
  cartShareText    String  @default("Share your cart")

  // Localization
  currencyCode   String @default("USD")
  currencySymbol String @default("$")
  locale         String @default("en-US")

  // Cart Recovery / WhatsApp Share
  cartRecoveryEnabled  Boolean @default(false)
  cartRecoveryWhatsApp String  @default("")
  cartRecoveryMessage  String  @default("Check out my cart: {{url}}")
  cartRecoveryLabel    String  @default("💬 Send cart link via WhatsApp")

  // Delivery Date Estimator
  deliveryEstimatorEnabled Boolean @default(false)
  deliveryMinDays          Int     @default(3)
  deliveryMaxDays          Int     @default(7)
  deliveryMessage          String  @default("Estimated delivery: {{date_range}}")
  deliveryCutoffHour       Int     @default(14)

  // Rotating Announcements (cycles through messages in banner area)
  announcementsEnabled  Boolean @default(false)
  announcements         String  @default("[]")
  announcementInterval  Int     @default(4)

  // Product Page Features
  productPageSocialProofEnabled  Boolean @default(false)
  productPageSocialProofText     String  @default("🔥 {{count}} people bought this today")
  productPageSocialProofMin      Int     @default(5)
  productPageSocialProofMax      Int     @default(30)
  productPageSocialProofInterval Int     @default(8)

  productPageScarcityEnabled    Boolean @default(false)
  productPageVolumeTableEnabled Boolean @default(false)
  productPageFreebieTeaser      Boolean @default(false)

  productPageUpsellEnabled   Boolean @default(false)
  productPageUpsellTitle     String  @default("Customers Also Bought")
  productPageUpsellLimit     Int     @default(3)
  productPageUpsellProducts  String  @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CartEvent {
  id        String   @id @default(cuid())
  shop      String
  event     String   // cart_open | checkout | upsell_add | freebie_add
  revenue   Int      @default(0)  // cart total in cents at event time
  variantId String?  // for upsell_add / freebie_add
  createdAt DateTime @default(now())

  @@index([shop, createdAt])
  @@index([shop, event])
}

model SupportMessage {
  id        String   @id @default(cuid())
  shop      String
  name      String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}
